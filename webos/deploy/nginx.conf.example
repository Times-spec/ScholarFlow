# Nginx 反向代理示例（HTTPS + SSE 支持）
# 用法：cp deploy/nginx.conf.example /etc/nginx/conf.d/smart-tour.conf
#       改 server_name 与证书路径 → nginx -t && systemctl reload nginx
#
# 注意：手机浏览器定位要求 HTTPS（安全上下文）。局域网 HTTP 地址在真机上无法定位，
#       但地图与规划仍可用；要做真实户外测试必须配置证书。

upstream smart_tour_app {
    server 127.0.0.1:8080;
    keepalive 16;
}

# HTTP 跳转到 HTTPS
server {
    listen 80;
    server_name tour.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name tour.example.com;

    ssl_certificate     /etc/letsencrypt/live/tour.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tour.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 上传体积（语音转写等，当前未启用可保留）
    client_max_body_size 10m;

    # 安全响应头
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://smart_tour_app;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # —— SSE（规划进度事件流）三件套，缺一个进度就会卡住 ——
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header X-Accel-Buffering no always;

        # —— 静态资源缓存（前端无构建，可直接缓存）——
        location ~* ^/(css|js|assets)/ {
            proxy_pass http://smart_tour_app;
            proxy_set_header Host $host;
            expires 1h;
            add_header Cache-Control "public, max-age=3600";
        }

        # 健康检查（不记入访问日志）
        location = /v1/config {
            access_log off;
            proxy_pass http://smart_tour_app;
            proxy_set_header Host $host;
        }
    }
}
